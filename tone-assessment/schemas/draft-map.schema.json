{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "draft-map.json — upstream drafting output (checked by G4)",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "matrix_ids"],
        "properties": {
          "heading": { "type": "string" },
          "matrix_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^F-[0-9]{3,}$" }
          }
        }
      }
    }
  }
}
