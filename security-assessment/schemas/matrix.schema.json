{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "matrix.json — output of 02-findings-matrix (validated by G2)",
  "type": "object",
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "section", "finding", "prior_state", "classification",
                     "update_required", "cis_ref", "nist_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "section": { "type": "string" },
          "finding": { "type": "string" },
          "prior_state": { "type": "string" },
          "evidence_path": { "type": "string" },
          "current_state": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["improved", "regressed", "unchanged", "resolved",
                     "newly-identified", "unable-to-validate"]
          },
          "update_required": { "type": "boolean" },
          "cis_ref": { "type": "string" },
          "nist_ref": { "type": "string" }
        },
        "comment": "G2 rule: evidence_path is REQUIRED unless classification == 'unable-to-validate'"
      }
    }
  }
}
